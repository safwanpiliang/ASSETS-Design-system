{
  "name": "assets-design-system",
  "version": "0.2.0",
  "description": "Component library React (kompatibel Next.js) untuk project-project ASSETS (Association of Software Engineering Student).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safwanpiliang/ASSETS-Design-system.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "preview"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=preview",
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/style.css --minify",
    "build": "npm run build:js && npm run build:css",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@solar-icons/react": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4"
  }
}
